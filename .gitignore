# Root .gitignore

# Dependencies
node_modules
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build outputs
.next/
**/.next/
out/
build/
dist/

# Local Environment
.env
.env.local
.env*.local
**/.env
**/.env.local
**/.env*.local
!.env.example
!**/.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & IDE
.DS_Store
*.pem
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/.vercel
scratch/
prototype/
# Credentials — never commit (plaintext passphrases/PINs, and bcrypt hashes of
# low-entropy passphrases, which are cheap to brute-force offline)
docs/College Login Credentials*.xlsx
docs/Staff Login Credentials*.md
docs/staff_credentials_*.sql
supabase/migrations/college_credentials_*.sql
docs/*Credentials*.xlsx
