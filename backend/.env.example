PORT=5000
NODE_ENV=development
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
# Must equal ATHLETE_QR_SECRET in frontend/web (signs/verifies ID-card QR codes), min 32 chars
ATHLETE_QR_SECRET=your-shared-athlete-qr-secret-min-32-chars
# Number of reverse-proxy hops in front of the API (1 behind nginx; 0 when exposed directly)
TRUST_PROXY=0

# Supabase Local Stack
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
